	bool "AURIX MCMCAN SOCKET NETDEV DRIVER"
	select NET
	select NET_CAN
	select NET_CAN_HAVE_CANFD
	select NET_CAN_HAVE_ERRORS
endchoice # MCMCAN character driver or SocketCAN support
