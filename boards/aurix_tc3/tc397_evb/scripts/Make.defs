include $(TOPDIR)/.config
include $(TOPDIR)/tools/Config.mk
include $(TOPDIR)/../vendor/infineon/chips/aurix/Toolchain.defs

define POSTBUILD
  $(OBJCOPY) -O binary nuttx nuttx.bin
  cp         nuttx           vela_$(CONFIG_ARCH_BOARD_CUSTOM_NAME).elf
  cp         nuttx.map       vela_$(CONFIG_ARCH_BOARD_CUSTOM_NAME).mapfile
  cp         nuttx.hex       vela_$(CONFIG_ARCH_BOARD_CUSTOM_NAME).hex
  cp         System.map      vela_$(CONFIG_ARCH_BOARD_CUSTOM_NAME).SystemMap
endef

ifeq ($(CONFIG_TRICORE_TOOLCHAIN_TASKING),y)
  ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)Lcf_Tasking_Tricore_Tc.lsl
else
  ifeq ($(CONFIG_TRICORE_BL),y)
    ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)Lcf_Gnuc_Tricore_Tc.lsl.bl
  endif
  ifeq ($(CONFIG_TRICORE_AP),y)
    ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)Lcf_Gnuc_Tricore_Tc.lsl.core$(CONFIG_CPU_COREID)
  endif
endif

CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
CPICFLAGS = $(ARCHPICFLAGS) $(CFLAGS)
CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
CXXPICFLAGS = $(ARCHPICFLAGS) $(CXXFLAGS)
CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
AFLAGS := $(CFLAGS) -D__ASSEMBLY__
