#include "memory_layout.h"

#define LCF_CSA0_SIZE     40k
#define LCF_USTACK0_SIZE  CONFIG_IDLETHREAD_STACKSIZE
#define LCF_ISTACK0_SIZE  CONFIG_ARCH_INTERRUPTSTACK

#define LCF_HEAP_SIZE  4k

#define LCF_CPU0 0
#define LCF_CPU1 1
#define LCF_CPU2 2
#define LCF_CPU3 3
#define LCF_CPU4 4
#define LCF_CPU5 5

/*Un comment one of the below statements to enable CpuX DMI RAM to hold global variables*/
#define LCF_DEFAULT_HOST LCF_CPU0

#define LCF_DSPR0_START  BL_DSPR_START
#define LCF_DSPR0_SIZE   BL_DSPR_SIZE

#define LCF_CSA0_OFFSET     (LCF_DSPR0_SIZE - 1k - LCF_CSA0_SIZE)
#define LCF_ISTACK0_OFFSET  (LCF_CSA0_OFFSET - 256 - LCF_ISTACK0_SIZE)
#define LCF_USTACK0_OFFSET  (LCF_ISTACK0_OFFSET - 256 - LCF_USTACK0_SIZE)
#define LCF_HEAP0_OFFSET    (LCF_USTACK0_OFFSET - LCF_HEAP_SIZE)

#define LCF_STARTPTR_CPU0   BL_PFLASH_START
#define LCF_TRAPVEC0_START  (LCF_STARTPTR_CPU0 + 0x20)
#define LCF_INTVEC0_START   (BL_PFLASH_START + BL_PFLASH_SIZE - 0x2000)

#define LCF_STARTPTR_NC_CPU0 NC_START(BL_PFLASH_START)
#define LCF_STARTPTR_NC_CPU1 NC_START(CORE1_PFLASH_KERNEL_START)
#define LCF_STARTPTR_NC_CPU2 NC_START(CORE2_PFLASH_KERNEL_START)
#define LCF_STARTPTR_NC_CPU3 NC_START(CORE3_PFLASH_KERNEL_START)
#define LCF_STARTPTR_NC_CPU4 NC_START(CORE4_PFLASH_KERNEL_START)
#define LCF_STARTPTR_NC_CPU5 NC_START(CORE5_PFLASH_KERNEL_START)

#define INTTAB0     (LCF_INTVEC0_START)
#define TRAPTAB0    (LCF_TRAPVEC0_START)

#define RESET BL_PFLASH_START

#include "tc1v1_6_2.lsl"

// Specify a multi-core processor environment (mpe)

processor mpe
{
    derivative = tc39;
}

derivative tc39
{
    core tc0
    {
        architecture = TC1V1.6.2;
        space_id_offset = 100;           // add 100 to all space IDs in the architecture definition
        copytable_space = vtc:linear;    // use the copy table in the virtual core for 'bss' and initialized data sections
    }

    core vtc
    {
        architecture = TC1V1.6.2;
        import tc0;                     // add all address spaces of core tc0 to core vtc for linking and locating
    }

    bus sri
    {
        mau = 8;
        width = 32;

        // map shared addresses one-to-one to real cores and virtual cores
        map (dest=bus:tc0:fpi_bus, src_offset=0, dest_offset=0, size=0xc0000000);
        map (dest=bus:vtc:fpi_bus, src_offset=0, dest_offset=0, size=0xc0000000);
    }

    memory dsram0 // Data Scratch Pad Ram
    {
        mau = 8;
        size = BL_DSPR_SIZE;
        type = ram;
        map (dest=bus:tc0:fpi_bus, dest_offset=DSPR_LOCAL_START, size=BL_DSPR_SIZE, priority=8);
        map (dest=bus:sri, dest_offset=BL_DSPR_START, size=BL_DSPR_SIZE);
    }

    memory psram0 // Program Scratch Pad Ram
    {
        mau = 8;
        size = BL_PSPR_SIZE;
        type = ram;
        map (dest=bus:tc0:fpi_bus, dest_offset=PSPR_LOCAL_START, size=BL_PSPR_SIZE, priority=8);
        map (dest=bus:sri, dest_offset=BL_PSPR_START, size=BL_PSPR_SIZE);
    }

    memory pfls0
    {
        mau = 8;
        size = BL_PFLASH_SIZE;
        type = rom;
        map     cached (dest=bus:sri, dest_offset=BL_PFLASH_START,           size=BL_PFLASH_SIZE);
        map not_cached (dest=bus:sri, dest_offset=NC_START(BL_PFLASH_START), reserved, size=BL_PFLASH_SIZE);
    }

    memory ucb
    {
        mau = 8;
        size = 80K;
        type = rom;
        map (dest=bus:sri, dest_offset=0xae400000, reserved, size=80K);
    }

    memory cpu0_dlmu
    {
        mau = 8;
        size = BL_DLMU_SIZE;
        type = ram;
        map     cached (dest=bus:sri, dest_offset=BL_DLMU_START,           size=BL_DLMU_SIZE);
        map not_cached (dest=bus:sri, dest_offset=NC_START(BL_DLMU_START), reserved, size=BL_DLMU_SIZE);
    }

    section_setup :vtc:linear
    {
        start_address
        (
            symbol = "_START"
        );
    }

    section_setup :vtc:linear
    {
        stack "ustack_tc0" (min_size = 1k, fixed, align = 8);
        stack "istack_tc0" (min_size = 1k, fixed, align = 8);
    }

    section_setup :vtc:linear
    {
        heap "heap" (min_size = LCF_HEAP_SIZE, align = 4);
    }

    /*Section setup for the copy table*/
    section_setup :vtc:linear
    {
        copytable
        (
            align = 4,
            dest = linear,
            table
            {
                symbol = "_lc_ub_table_tc0";
                space = :tc0:linear, :tc0:abs24, :tc0:abs18, :tc0:csa;
            }
        );
    }

    /*Sections located at absolute fixed address*/

    section_layout :vtc:linear
    {
        /*Fixed memory Allocations for stack memory and CSA*/
        group (ordered)
        {
            group ustack0(align = 8, run_addr = mem:dsram0[LCF_USTACK0_OFFSET])
            {
                stack "ustack_tc0" (size = LCF_USTACK0_SIZE);
            }
            "__USTACK0":= sizeof(group:ustack0) > 0  ? "_lc_ue_ustack_tc0" : 0;
            "__USTACK0_END"="_lc_gb_ustack0";
            "__USTACK":= "__USTACK0";
            "__USTACK_END"="__USTACK0_END";

            group istack0(align = 8, run_addr = mem:dsram0[LCF_ISTACK0_OFFSET])
            {
                stack "istack_tc0" (size = LCF_ISTACK0_SIZE);
            }
            "__ISTACK0":= sizeof(group:istack0) > 0  ? "_lc_ue_istack_tc0" : 0;
            "__ISTACK0_END"="_lc_gb_istack0";
            "__ISTACK"="__ISTACK0";
            "__ISTACK_END"="__ISTACK0_END";

            group (align = 64, attributes=rw, run_addr=mem:dsram0[LCF_CSA0_OFFSET])
                reserved "csa_tc0" (size = LCF_CSA0_SIZE);
            "__CSA0":=        "_lc_ub_csa_tc0";
            "__CSA0_END":=    "_lc_ue_csa_tc0";
        }

        /*Fixed memory Allocations for _START*/
        group (ordered)
        {
          group  reset (run_addr=RESET)
          {
            section "reset" ( size = 0x20, attributes = rx, fill = 0x0800 )
            {
              select ".text.start";
            }
          }
          group  interface_const (run_addr=mem:pfls0[0x0020])
          {
            select "*.interface_const";
          }
          "__IF_CONST" := addressof(group:interface_const);
          "__START0" := BL_PFLASH_START;
        }

        /*Fixed memory Allocations for Trap Vector Table*/
        group (ordered)
        {
            group trapvec_tc0 (align = 8, run_addr=LCF_TRAPVEC0_START)
            {
                section "trapvec_tc0" (size=0x100, attributes=rx, fill=0)
                {
                    select "(.text.traptab_cpu0*)";
                }
            }
            "__TRAPTAB_CPU0" := TRAPTAB0;
        }

        /*Fixed memory Allocations for Start up code*/
        group (ordered, attributes=rx)
        {
            group start_tc0 (run_addr=LCF_STARTPTR_NC_CPU0)
            {
                select "(.text.start_cpu0*)";
            }
            "__ENABLE_INDIVIDUAL_C_INIT_CPU0" := 0; /* Not used */
        }

        /*Fixed memory Allocations for Interrupt Vector Table*/
        group (ordered, attributes=rx)
        {
            group int_tab_tc0 (ordered)
            {
              group (run_addr=(INTTAB0)+0x0000) select ".text.inttab0.intvec.000";
              group (run_addr=(INTTAB0)+0x0020) select ".text.inttab0.intvec.001";
              group (run_addr=(INTTAB0)+0x0040) select ".text.inttab0.intvec.002";
              group (run_addr=(INTTAB0)+0x0060) select ".text.inttab0.intvec.003";
              group (run_addr=(INTTAB0)+0x0080) select ".text.inttab0.intvec.004";
              group (run_addr=(INTTAB0)+0x00A0) select ".text.inttab0.intvec.005";
              group (run_addr=(INTTAB0)+0x00C0) select ".text.inttab0.intvec.006";
              group (run_addr=(INTTAB0)+0x00E0) select ".text.inttab0.intvec.007";
              group (run_addr=(INTTAB0)+0x0100) select ".text.inttab0.intvec.008";
              group (run_addr=(INTTAB0)+0x0120) select ".text.inttab0.intvec.009";
              group (run_addr=(INTTAB0)+0x0140) select ".text.inttab0.intvec.00a";
              group (run_addr=(INTTAB0)+0x0160) select ".text.inttab0.intvec.00b";
              group (run_addr=(INTTAB0)+0x0180) select ".text.inttab0.intvec.00c";
              group (run_addr=(INTTAB0)+0x01A0) select ".text.inttab0.intvec.00d";
              group (run_addr=(INTTAB0)+0x01C0) select ".text.inttab0.intvec.00e";
              group (run_addr=(INTTAB0)+0x01E0) select ".text.inttab0.intvec.00f";
              group (run_addr=(INTTAB0)+0x0200) select ".text.inttab0.intvec.010";
              group (run_addr=(INTTAB0)+0x0220) select ".text.inttab0.intvec.011";
              group (run_addr=(INTTAB0)+0x0240) select ".text.inttab0.intvec.012";
              group (run_addr=(INTTAB0)+0x0260) select ".text.inttab0.intvec.013";
              group (run_addr=(INTTAB0)+0x0280) select ".text.inttab0.intvec.014";
              group (run_addr=(INTTAB0)+0x02A0) select ".text.inttab0.intvec.015";
              group (run_addr=(INTTAB0)+0x02C0) select ".text.inttab0.intvec.016";
              group (run_addr=(INTTAB0)+0x02E0) select ".text.inttab0.intvec.017";
              group (run_addr=(INTTAB0)+0x0300) select ".text.inttab0.intvec.018";
              group (run_addr=(INTTAB0)+0x0320) select ".text.inttab0.intvec.019";
              group (run_addr=(INTTAB0)+0x0340) select ".text.inttab0.intvec.01a";
              group (run_addr=(INTTAB0)+0x0360) select ".text.inttab0.intvec.01b";
              group (run_addr=(INTTAB0)+0x0380) select ".text.inttab0.intvec.01c";
              group (run_addr=(INTTAB0)+0x03A0) select ".text.inttab0.intvec.01d";
              group (run_addr=(INTTAB0)+0x03C0) select ".text.inttab0.intvec.01e";
              group (run_addr=(INTTAB0)+0x03E0) select ".text.inttab0.intvec.01f";
              group (run_addr=(INTTAB0)+0x0400) select ".text.inttab0.intvec.020";
              group (run_addr=(INTTAB0)+0x0420) select ".text.inttab0.intvec.021";
              group (run_addr=(INTTAB0)+0x0440) select ".text.inttab0.intvec.022";
              group (run_addr=(INTTAB0)+0x0460) select ".text.inttab0.intvec.023";
              group (run_addr=(INTTAB0)+0x0480) select ".text.inttab0.intvec.024";
              group (run_addr=(INTTAB0)+0x04A0) select ".text.inttab0.intvec.025";
              group (run_addr=(INTTAB0)+0x04C0) select ".text.inttab0.intvec.026";
              group (run_addr=(INTTAB0)+0x04E0) select ".text.inttab0.intvec.027";
              group (run_addr=(INTTAB0)+0x0500) select ".text.inttab0.intvec.028";
              group (run_addr=(INTTAB0)+0x0520) select ".text.inttab0.intvec.029";
              group (run_addr=(INTTAB0)+0x0540) select ".text.inttab0.intvec.02a";
              group (run_addr=(INTTAB0)+0x0560) select ".text.inttab0.intvec.02b";
              group (run_addr=(INTTAB0)+0x0580) select ".text.inttab0.intvec.02c";
