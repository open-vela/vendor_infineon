#include "memory_layout.h"

#define LCF_SYSLOG_START        AURIX_RPMSG_CORE0CORECS_SYSLOG_START
#define LCF_SYSLOG_SIZE         AURIX_RPMSG_CORE0CORECS_SYSLOG_SIZE

#define LCF_USTACK6_SIZE  CONFIG_IDLETHREAD_STACKSIZE
#define LCF_ISTACK6_SIZE  CONFIG_ARCH_INTERRUPTSTACK

#define LCF_HEAP_SIZE 4k

#define LCF_CPU6 6

/*Un comment one of the below statements to enable CpuX DMI RAM to hold global variables*/
#define LCF_DEFAULT_HOST LCF_CPU6

#define LCF_DSPR6_START  CORE6_DSPR_KERNEL_START
#define LCF_DSPR6_SIZE   CORE6_DSPR_KERNEL_SIZE

#define LCF_ISTACK6_OFFSET  (LCF_DSPR6_SIZE - 256 - LCF_ISTACK6_SIZE)
#define LCF_USTACK6_OFFSET  (LCF_ISTACK6_OFFSET - 256 - LCF_USTACK6_SIZE)

#define LCF_STARTPTR_CPU6   CORE6_PFLASH_KERNEL_START
#define LCF_TRAPVEC6_START  (LCF_STARTPTR_CPU6 + 0x100)

#define LCF_INTVEC6_START   CORE6_PFLASH_KERNEL_START
#define LCF_STARTPTR_NC_CPU6 NC_START(CORE6_PFLASH_KERNEL_START)

#define INTTAB6             (LCF_INTVEC6_START)
#define TRAPTAB6            (LCF_TRAPVEC6_START)

#define RESET CORE6_PFLASH_KERNEL_START

#include "tc1v1_8.lsl"

// Specify a multi-core processor environment (mpe)

processor mpe
{
    derivative = tc4D;
}

derivative tc4D
{
    core tc6
    {
        architecture = TC1V1.8;
        space_id_offset = 700;           // add 100 to all space IDs in the architecture definition
        copytable_space = vtc:linear;    // use the copy table in the virtual core for 'bss' and initialized data sections
    }

    core vtc
    {
        architecture = TC1V1.8;
        import tc6;                     //                                tc6
    }

    bus sri
    {
        mau = 8;
        width = 32;

        // map shared addresses one-to-one to real cores and virtual cores
        map (dest=bus:tc6:fpi_bus, src_offset=0, dest_offset=0, size=0xc0000000);
        map (dest=bus:vtc:fpi_bus, src_offset=0, dest_offset=0, size=0xc0000000);
    }

    memory dsram6 // Data Scratch Pad Ram
    {
        mau = 8;
        size = CORE6_DSPR_KERNEL_SIZE;
        type = ram;
        map (dest=bus:tc6:fpi_bus, dest_offset=DSPR_LOCAL_START, size=CORE6_DSPR_KERNEL_SIZE, priority=8);
        map (dest=bus:sri, dest_offset=CORE6_DSPR_KERNEL_START, size=CORE6_DSPR_KERNEL_SIZE);
    }

    memory psram6 // Program Scratch Pad Ram
    {
        mau = 8;
        size = CORE6_PSPR_KERNEL_SIZE;
        type = ram;
        map (dest=bus:tc6:fpi_bus, dest_offset=PSPR_LOCAL_START, size=CORE6_PSPR_KERNEL_SIZE, priority=8);
        map (dest=bus:sri, dest_offset=CORE6_PSPR_KERNEL_START, size=CORE6_PSPR_KERNEL_SIZE);
    }

    memory pfls6
    {
        mau = 8;
        size = CORE6_PFLASH_KERNEL_SIZE;
        type = rom;
        map     cached (dest=bus:sri, dest_offset=CORE6_PFLASH_KERNEL_START, size=CORE6_PFLASH_KERNEL_SIZE);
        map not_cached (dest=bus:sri, dest_offset=NC_START(CORE6_PFLASH_KERNEL_START), reserved, size=CORE6_PFLASH_KERNEL_SIZE);
    }

    memory ucb_cs
    {
        mau = 8;
        size = 52K - 4K;
        type = rom;
        map (dest=bus:sri, dest_offset=0xaec01800, reserved, size=52K - 4K);
    }

    memory syslog
    {
        mau = 8;
        size = LCF_SYSLOG_SIZE;
        type = ram;
        map not_cached (dest=bus:sri, dest_offset=LCF_SYSLOG_START, size=LCF_SYSLOG_SIZE);
    }

    section_setup :vtc:linear
    {
        heap "heap1" (min_size = LCF_HEAP_SIZE, fixed, align = 4);
    }

    section_setup :vtc:linear
    {
        start_address
        (
            symbol = "_START6"
        );
    }

    section_setup :vtc:linear
    {
        stack "ustack_tc6" (min_size = 1k, fixed, align = 8);
        stack "istack_tc6" (min_size = 1k, fixed, align = 8);
    }

    /*Section setup for the copy table*/
    section_setup :vtc:linear
    {
        copytable
        (
            align = 4,
            dest = linear,
            table
            {
                symbol = "_lc_ub_table_tc6";
                space = :tc6:linear, :tc6:abs24, :tc6:abs18;
            }
        );
    }

    /*Sections located at absolute fixed address*/

    section_layout :vtc:linear
    {
        /*Fixed memory Allocations for stack memory*/
        group (ordered)
        {
            group ustack6(align = 8, run_addr = mem:dsram6[LCF_USTACK6_OFFSET])
            {
                stack "ustack_tc6" (size = LCF_USTACK6_SIZE);
            }
            "__USTACK6":= sizeof(group:ustack6) > 0  ? "_lc_ue_ustack_tc6" : 0;
            "__USTACK6_END"="_lc_gb_ustack6";
            "__USTACK":= "__USTACK6";
            "__USTACK_END"="__USTACK6_END";

            group istack6(align = 8, run_addr = mem:dsram6[LCF_ISTACK6_OFFSET])
            {
                stack "istack_tc6" (size = LCF_ISTACK6_SIZE);
            }
            "__ISTACK6":= sizeof(group:istack6) > 0  ? "_lc_ue_istack_tc6" : 0;
            "__ISTACK6_END"="_lc_gb_istack6";
            "__ISTACK"="__ISTACK6";
            "__ISTACK_END"="__ISTACK6_END";
        }

        /*Fixed memory Allocations for _START*/
        group (ordered)
        {
          group  reset (run_addr=RESET)
          {
            section "reset" ( size = 0x20, attributes = rx, fill = 0x0800 )
            {
              select ".text.start_cpu6";
            }
          }
          group  interface_const (run_addr=mem:pfls6[0x0020])
          {
            select "*.interface_const";
          }
          "__IF_CONST" := addressof(group:interface_const);
          "__START6" := CORE6_PFLASH_KERNEL_START;
        }

        /*Fixed memory Allocations for Trap Vector Table*/
        group (ordered)
        {
            group trapvec_tc6 (align = 8, run_addr=LCF_TRAPVEC6_START)
            {
                section "trapvec_tc6" (size=0x100, attributes=rx, fill=0)
                {
                    select "(.text.traptab_cpu6*)";
                }
            }
            "__TRAPTAB_CPU6" := TRAPTAB6;
        }

        /*Fixed memory Allocations for Start up code*/
        group (ordered, attributes=rx)
        {
            group start_tc6 (run_addr=LCF_STARTPTR_NC_CPU6)
            {
                select "(.text.start_cpu6*)";
            }
            "__ENABLE_INDIVIDUAL_C_INIT_CPU6" := 0; /* Not used */
        }

        /*Fixed memory Allocations for Interrupt Vector Table*/
        group (ordered, attributes=rx)
        {
            group int_tab_tc6 (ordered)
            {
              group (run_addr=(INTTAB6)+0x0000) select ".text.inttab6.intvec.000";
              group (run_addr=(INTTAB6)+0x0020) select ".text.inttab6.intvec.001";
              group (run_addr=(INTTAB6)+0x0040) select ".text.inttab6.intvec.002";
              group (run_addr=(INTTAB6)+0x0060) select ".text.inttab6.intvec.003";
              group (run_addr=(INTTAB6)+0x0080) select ".text.inttab6.intvec.004";
              group (run_addr=(INTTAB6)+0x00A0) select ".text.inttab6.intvec.005";
              group (run_addr=(INTTAB6)+0x00C0) select ".text.inttab6.intvec.006";
              group (run_addr=(INTTAB6)+0x00E0) select ".text.inttab6.intvec.007";
              group (run_addr=(INTTAB6)+0x0100) select ".text.inttab6.intvec.008";
              group (run_addr=(INTTAB6)+0x0120) select ".text.inttab6.intvec.009";
              group (run_addr=(INTTAB6)+0x0140) select ".text.inttab6.intvec.00a";
              group (run_addr=(INTTAB6)+0x0160) select ".text.inttab6.intvec.00b";
              group (run_addr=(INTTAB6)+0x0180) select ".text.inttab6.intvec.00c";
              group (run_addr=(INTTAB6)+0x01A0) select ".text.inttab6.intvec.00d";
              group (run_addr=(INTTAB6)+0x01C0) select ".text.inttab6.intvec.00e";
              group (run_addr=(INTTAB6)+0x01E0) select ".text.inttab6.intvec.00f";
              group (run_addr=(INTTAB6)+0x0200) select ".text.inttab6.intvec.010";
              group (run_addr=(INTTAB6)+0x0220) select ".text.inttab6.intvec.011";
              group (run_addr=(INTTAB6)+0x0240) select ".text.inttab6.intvec.012";
              group (run_addr=(INTTAB6)+0x0260) select ".text.inttab6.intvec.013";
              group (run_addr=(INTTAB6)+0x0280) select ".text.inttab6.intvec.014";
              group (run_addr=(INTTAB6)+0x02A0) select ".text.inttab6.intvec.015";
              group (run_addr=(INTTAB6)+0x02C0) select ".text.inttab6.intvec.016";
              group (run_addr=(INTTAB6)+0x02E0) select ".text.inttab6.intvec.017";
              group (run_addr=(INTTAB6)+0x0300) select ".text.inttab6.intvec.018";
              group (run_addr=(INTTAB6)+0x0320) select ".text.inttab6.intvec.019";
              group (run_addr=(INTTAB6)+0x0340) select ".text.inttab6.intvec.01a";
              group (run_addr=(INTTAB6)+0x0360) select ".text.inttab6.intvec.01b";
