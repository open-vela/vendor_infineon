            "__INTTAB_CPU6" = (LCF_INTVEC6_START);
        }

        /*Fixed memory Allocations for BMHD*/
        group (ordered)
        {
            group  bmhdcs_0_org (run_addr=mem:ucb_cs[0x0000])
            {
                select ".rodata.bmhdcs_0_orig";
            }
            group  bmhdcs_1_org (run_addr=mem:ucb_cs[0x0800])
            {
                select ".rodata.bmhdcs_1_orig";
            }
            group  bmhdcs_2_org (run_addr=mem:ucb_cs[0x1000])
            {
                select ".rodata.bmhdcs_2_orig";
            }
            group  bmhdcs_3_org (run_addr=mem:ucb_cs[0x1800])
            {
                select ".rodata.bmhdcs_3_orig";
            }
            group  csusercfg_0_orig (run_addr=mem:ucb_cs[0x6000])
            {
                select ".rodata.csusercfg_0_orig";
            }
            group  csusercfg_0_copy (run_addr=mem:ucb_cs[0x6800])
            {
                select ".rodata.csusercfg_0_copy";
            }
        }
    }

    /*Near Abbsolute Addressable Data Sections*/
    section_layout :vtc:abs18
    {
        /*Near Absolute Data, selectable with patterns and user defined sections*/
        group
        {
            group (ordered, contiguous, align = 4, attributes=rw, run_addr = mem:dsram6)
            {
                select "(.zdata.zdata_cpu6|.zdata.zdata_cpu6.*)";
                select "(.zbss.zbss_cpu6|.zbss.zbss_cpu6.*)";
            }
        }

        /*Near Absolute Data, selectable by toolchain*/
        group (ordered, contiguous, align = 4, attributes=rw, run_addr = mem:dsram6)
        {
            group zdata_mcal(attributes=rw)
            {
                select ".zdata.dsprInit.cpu6.32bit";
                select ".zdata.dsprInit.cpu6.16bit";
                select ".zdata.dsprInit.cpu6.8bit";
            }

            group zdata_powerOn(attributes=rw)
            {
                select ".zdata.dsprPowerOnInit.cpu6.32bit";
                select ".zdata.dsprPowerOnInit.cpu6.16bit";
                select ".zdata.dsprPowerOnInit.cpu6.8bit";
            }

            group zbss_mcal(attributes=rw)
            {
                select ".zbss.dsprClearOnInit.cpu6.32bit";
                select ".zbss.dsprClearOnInit.cpu6.16bit";
                select ".zbss.dsprClearOnInit.cpu6.8bit";
            }

            group zbss_noClear(attributes=rw)
            {
                select ".zbss.dsprNoInit.cpu6.32bit";
                select ".zbss.dsprNoInit.cpu6.16bit";
                select ".zbss.dsprNoInit.cpu6.8bit";
            }

            group zbss_powerOn(attributes=rw)
            {
                select ".zbss.dsprPowerOnClear.cpu6.32bit";
                select ".zbss.dsprPowerOnClear.cpu6.16bit";
                select ".zbss.dsprPowerOnClear.cpu6.8bit";
            }

            group zdata(attributes=rw)
            {
                select "(.zdata|.zdata.*)";
                select "(.zbss|.zbss.*)";
            }
        }

        /*Near Absolute Const, selectable with patterns and user defined sections*/
        group
        {
            group (ordered, contiguous, align = 4, attributes=r, run_addr=mem:pfls6)
            {
                select ".zrodata.Ifx_Ssw_Tc6.*";
                select ".zrodata.Cpu6_Main.*";

                /*Near Absolute Const, selectable by toolchain*/
                select ".zrodata.const.cpu6.32bit";
                select ".zrodata.const.cpu6.16bit";
                select ".zrodata.const.cpu6.8bit";
                select ".zrodata.config.cpu6.32bit";
                select ".zrodata.config.cpu6.16bit";
                select ".zrodata.config.cpu6.8bit";
                select "(.zrodata|.zrodata.*)";
            }
        }
    }

    /*Relative A0/A1/A8/A9 Addressable Sections*/
    section_layout :vtc:linear
    {
        /*Relative A0 Addressable Data, selectable by toolchain*/
        group a0 (ordered, contiguous, align = 4, attributes=rw, run_addr = mem:dsram6)
        {
            select "(.sdata|.sdata.*)";
            select "(.data_a0|.data_a0.*)";
            select "(.sbss|.sbss.*)";
            select "(.bss_a0|.bss_a0.*)";
        }
        "_SMALL_DATA_" := sizeof(group:a0) > 0 ? addressof(group:a0) : addressof(group:a0) & 0xF0000000 + 32k;
        "__A0_MEM" = "_SMALL_DATA_";

        /*Relative A1 Addressable Const, selectable by toolchain*/
        /*Small constant sections, No option given for CPU specific user sections to make generated code portable across Cpus*/
        group  a1 (ordered, align = 4, attributes=r, run_addr=mem:pfls6)
        {
          select "(.srodata|.srodata.*)";
          select "(.ldata|.ldata.*)";
          select "(.rodata_a1|.rodata_a1.*)";
        }
        "_LITERAL_DATA_" := sizeof(group:a1) > 0 ? addressof(group:a1) : addressof(group:a1) & 0xF0000000 + 32k;
        "__A1_MEM" = "_LITERAL_DATA_";

        /*Relative A9 Addressable Data, selectable with patterns and user defined sections*/
        group a9 (ordered, align = 4, run_addr=mem:dsram6)
        {
            select "(.a9sdata|.a9sdata.*)";
            select "(.data_a9|.data_a9.*)";
            select "(.a9sbss|.a9sbss.*)";
            select "(.bss_a9|.bss_a9.*)";
        }
        "_A9_DATA_" := sizeof(group:a9) > 0 ? addressof(group:a9) : addressof(group:a9) & 0xF0000000 + 32k;
        "__A9_MEM" = "_A9_DATA_";

        /*Relative A8 Addressable Const, selectable with patterns and user defined sections*/
        group  a8 (ordered, align = 4, run_addr=mem:pfls6)
        {
          select "(.a8srodata|.a8srodata.*)";
          select "(.rodata_a8|.rodata_a8.*)";
        }
        "_A8_DATA_" := sizeof(group:a8) > 0 ? addressof(group:a8) : addressof(group:a8) & 0xF0000000 + 32k;
        "__A8_MEM" = "_A8_DATA_";
    }

    /*syslog ram*/
    section_layout :vtc:linear
    {
        group syslog(ordered, nocopy, run_addr=mem:syslog)
        {
            select "(.syslog|.syslog.*)";
        }
    }

    /*Far Data / Far Const Sections, selectable with patterns and user defined sections*/
    section_layout :vtc:linear
    {
        /*Far Data Sections, selectable with patterns and user defined sections*/

        /*DSRAM sections*/
        group
        {
            group (ordered, attributes=rw, run_addr=mem:dsram6)
            {
                select ".data.Ifx_Ssw_Tc6.*";
                select ".data.Cpu6_Main.*";
                select "(.data.data_cpu6|.data.data_cpu6.*)";
                select ".bss.Ifx_Ssw_Tc6.*";
                select ".bss.Cpu6_Main.*";
                select "(.bss.bss_cpu6|.bss.bss_cpu6.*)";
            }
        }

        /*Far Data Sections, selectable by toolchain*/
        group uncached_data(ordered, contiguous, align = 4, attributes=rw, run_addr = mem:dsram6[0])
        {
            select "(.data.uncached.*)";
            select "(.bss.uncached.*)";
        }

        group (ordered, contiguous, align = 4, attributes=rw, run_addr = mem:dsram6)
        {
            group data_mcal(attributes=rw)
            {
                select ".data.farDsprInit.cpu6.32bit";
                select ".data.farDsprInit.cpu6.16bit";
                select ".data.farDsprInit.cpu6.8bit";
            }

            group bss_mcal(attributes=rw)
            {
                select ".bss.farDsprClearOnInit.cpu6.32bit";
                select ".bss.farDsprClearOnInit.cpu6.16bit";
                select ".bss.farDsprClearOnInit.cpu6.8bit";
            }

            group bss_noInit(attributes=rw)
            {
                select ".bss.farDsprNoInit.cpu6.32bit";
                select ".bss.farDsprNoInit.cpu6.16bit";
                select ".bss.farDsprNoInit.cpu6.8bit";
            }

            group dtcm_stack(attributes=rw)
            {
                select "(.dtcm_stack|.dtcm_stack.*)";
            }

            group data(attributes=rw)
            {
                select "(.data|.data.*)";
                select "(.bss|.bss.*)";
            }
        }

        group heap1(attributes=rw)
        {
            heap "heap1" (size = LCF_HEAP_SIZE);
        }
        "_sheap":="_lc_ub_heap1";
        "_eheap":="__USTACK_END";

        /*Far Const Sections, selectable with patterns and user defined sections*/
        group
        {
            group (ordered, align = 4, attributes=r, run_addr=mem:pfls6)
            {
                select ".rodata.Ifx_Ssw_Tc6.*";
                select ".rodata.Cpu6_Main.*";
                select "(.rodata.rodata_cpu6|.rodata.rodata_cpu6.*)";
            }
        }

        /*Far Const Sections, selectable by toolchain*/
        group (ordered, align = 4, run_addr=mem:pfls6)
        {
            select ".rodata.farConst.cpu6.32bit";
            select ".rodata.farConst.cpu6.16bit";
            select ".rodata.farConst.cpu6.8bit";
            select "(.rodata|.rodata.*)";
        }
    }

    /* PSRAM Code selections*/
    section_layout :vtc:linear
    {
        /*Code Sections, selectable with patterns and user defined sections*/
        group
        {
            /*Program Scratchpad Sections*/
            group
            {
                group code_psram6 (ordered, attributes=rwx, copy, run_addr=mem:psram6)
                {
                    select "(.text.cpu6_psram|.text.cpu6_psram.*)";
                    select "(.text.psram_text_cpu6|.text.psram_text_cpu6.*)";
                }
            }
        }
    }

    /* FLS Code selections*/
    section_layout :vtc:linear
    {
        /*Code Sections, selectable with patterns and user defined sections*/
        group
        {
            /*Cpu specific PFLASH Sections*/
            group
            {
                group (ordered, align = 4, attributes=rx, run_addr=mem:pfls6)
                {
                    select ".text.Ifx_Ssw_Tc6.*";
                    select ".text.Cpu6_Main.*";
                    select ".text.CompilerTasking.Ifx_C_Init";
                    select "(.text.text_cpu6|.text.text_cpu6.*)";
                }
            }
        }

        /*Code Sections, selectable by toolchain*/
        group (ordered, run_addr=mem:pfls6)
        {
            select ".text.fast.pfls.cpu6";
            select ".text.slow.pfls.cpu6";
            select ".text.5ms.pfls.cpu6";
            select ".text.10ms.pfls.cpu6";
            select ".text.callout.pfls.cpu6";
            select "(.text|.text.*)";
        }
    }
}
